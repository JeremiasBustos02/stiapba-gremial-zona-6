# Desarrollo local. Para producción, usar exclusivamente las variables del servicio.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stiapba
DB_USERNAME=stiapba
DB_PASSWORD=change-me-local
# En producción se usan defaults conservadores (máximo 3, mínimo 1) para Supabase Session Pooler.
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
PORT=8080
FRONTEND_URL=http://localhost:5173
# El frontend usa el proxy de Vite durante desarrollo. En Vercel debe ser la URL HTTPS completa de Render terminada en /api/v1.
VITE_API_URL=/api/v1
VITE_BACKEND_PROXY_URL=http://localhost:8080
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
INITIAL_ADMIN_DNI=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_LASTNAME=
TEMPLATE_STORAGE_TYPE=local
TEMPLATE_STORAGE_PATH=storage/templates
TEMPLATE_MAX_FILE_SIZE=10MB
TEMPLATE_MAX_FILE_SIZE_BYTES=10485760
TEMPLATE_SEED_ENABLED=true
# Ruta absoluta recomendada en producción; en desarrollo puede apuntar al PDF versionado.
TEMPLATE_SEED_FILE=../docs/pdf-templates/Permiso-Gremial-Bruna.pdf
TEMPLATE_ACROFORM_SEED_FILE=../docs/pdf-templates/Permiso-Gremial-Bruna-ACROFORM.pdf
# Solo con TEMPLATE_STORAGE_TYPE=s3. Nunca exponer estas credenciales al frontend.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# En producción Supabase requiere TLS. application-prod.yml usa este valor en la URL JDBC.
DB_SSL_MODE=require
