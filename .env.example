# Desarrollo local. Para producción, usar un gestor de secretos o variables del entorno de ejecución.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stiapba
DB_USERNAME=stiapba
DB_PASSWORD=change-me-local
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:5173
# El frontend usa el proxy de Vite durante desarrollo y /api/v1 detrás del reverse proxy en producción.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_URL=http://localhost:8080
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
INITIAL_ADMIN_DNI=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_LASTNAME=
TEMPLATE_STORAGE_PATH=storage/templates
TEMPLATE_MAX_FILE_SIZE=10MB
TEMPLATE_MAX_FILE_SIZE_BYTES=10485760
TEMPLATE_SEED_ENABLED=true
# Ruta absoluta recomendada en producción; en desarrollo puede apuntar al PDF versionado.
TEMPLATE_SEED_FILE=../docs/pdf-templates/Permiso-Gremial-Bruna.pdf
